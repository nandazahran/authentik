# Caddyfile.tunnel: ingress untuk mode publik (Cloudflare Tunnel)
#
# Dipakai bersama docker-compose.tunnel.yml. Nama host publik dikirim lewat
# environment variables container Caddy (bukan hardcode di sini):
#   AUTH_PUBLIC_HOST, TOOLS_PUBLIC_HOST, POZNOTE_PUBLIC_HOST: FQDN penuh
#   tanpa skema/path/port, mis. subdomain di bawah domain Cloudflare Anda.
#
# - cloudflared mengirim permintaan ke Caddy lewat HTTP di jaringan internal
#   Compose, jadi alamat situs ditulis "http://..." eksplisit: Caddy tidak
#   mencoba ACME dan tidak melakukan redirect TLS (HTTPS dihentikan di edge
#   Cloudflare). Tidak ada "tls internal" di file ini.
# - trusted_proxies: cloudflared adalah satu-satunya pengirim yang dikenal
#   Caddy, dan Caddy tidak mempublikasikan port apa pun. Tanpa trusted_proxies,
#   header X-Forwarded-* dari cloudflared diabaikan (nilai default Caddy:
#   tidak ada proxy yang dipercaya), sehingga Authentik tidak melihat skema
#   HTTPS asli.
# - request_header -X-Forwarded-Host: header X-Forwarded-Host dari klien
#   dibuang, sehingga host yang diteruskan ke backend diturunkan dari Host
#   yang dirutekan, bukan dari header buatan klien.

{
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

# Authentik
http://{$AUTH_PUBLIC_HOST} {
	request_header -X-Forwarded-Host
	reverse_proxy server:9000
}

# IT-Tools, dilindungi forward auth
http://{$TOOLS_PUBLIC_HOST} {
	request_header -X-Forwarded-Host

	# Urutan handler hanya dijamin dengan route (template Caddy resmi Authentik):
	# 1. path outpost diteruskan ke outpost embedded, 2. forward auth,
	# 3. aplikasi.
	route {
		reverse_proxy /outpost.goauthentik.io/* server:9000

		forward_auth server:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			# Huruf besar/kecil nama header penting, jika tidak isinya kosong
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
			trusted_proxies private_ranges
		}

		reverse_proxy it-tools:80
	}
}

# Poznote, login lewat OIDC
http://{$POZNOTE_PUBLIC_HOST} {
	request_header -X-Forwarded-Host
	reverse_proxy poznote:80
}
